{
	"name": "setup-biome",
	"description": "Setup the Biome CLI in GitHub Actions",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"tag": "node --experimental-strip-types scripts/tag-github-action.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.mjs --minify",
		"test": "node --experimental-strip-types --test src/version.test.ts",
		"check": "biome check --write",
		"typecheck": "tsc --noEmit",
		"ci": "biome ci",
		"update-readme-package-versions": "node --experimental-strip-types scripts/update-readme-package-versions.ts"
	},
	"keywords": [
		"biome",
		"biomejs",
		"cli",
		"github-action"
	],
	"author": {
		"name": "Nicolas Hedger",
		"email": "nicolas@hedger.ch"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/tool-cache": "4.0.0",
		"@octokit/auth-action": "6.0.3",
		"@octokit/request-error": "7.1.2",
		"@octokit/rest": "22.0.1",
		"@std/jsonc": "npm:@jsr/std__jsonc@1.0.3",
		"find-up-simple": "1.0.1",
		"semver": "7.8.5",
		"ts-dedent": "2.3.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@octokit/types": "18.0.0",
		"@pnpm/lockfile-types": "7.1.3",
		"@types/node": "24.19.2",
		"@types/semver": "7.8.0",
		"esbuild": "0.28.2",
		"lefthook": "2.2.2",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@12.23.0"
}
